#!/usr/bin/env node
// G7 live re-check (#470): throwaway client of the shared Codex app-server daemon.
// Quarantined (oac-gates "Throwaway rule"); never imported, never part of the product.
//
// It extends the S3 capture client (docs/planning/gates/fixtures/s3-codex-capture/
// client.mjs.throwaway-quarantined: same transport, same transcript format, the queued-
// interrupt, extra-member, after-interrupt and unloaded-thread cases) with the queue
// management of risk row 66 (b) and the resume override probe of risk row 73:
//   hello                          initialize only (the wire userAgent)
//   cases <cwd> [set] [quietMs] [deadlineMs]   the cases below; set `all` (default), `row66` or `row73`;
//                                  quietMs is the "nothing happens" window (default 25000)
//
// Row 66 (docs/planning/v0.1/11-risks.md), each on a thread this process starts itself:
//   a1  two adds made during a running turn that is then interrupted: they wait, and run one
//       per idle after the next uninterrupted turn
//   a2  an add made after turn/interrupt to the idle thread whose last turn was interrupted
//       waits, and runs after the next uninterrupted turn
//   b   a second daemon client, one that never started or resumed the thread, lists, updates,
//       reorders and deletes the items held in a thread's queue; then what dispatches
//   c   an add to an unloaded thread waits; thread/resume dispatches it
//   d   an extra member in a thread/queue/add request is accepted and ignored
// Row 73: a thread/resume that carries ONE setting override (approvalPolicy) is sent to a thread
// that is loaded and idle WITH subscribers, to one that is loaded and idle with NO subscriber, and,
// as the control, to one that is not loaded (the app-server treats these differently, rust-v0.166.0
// thread_processor.rs L4697-L4748); the responses, a resume without an override afterwards, and any
// thread/settings/updated notification are recorded. THIS IS A TEST CLIENT DELIBERATELY DOING WHAT OAC ITSELF MUST NEVER DO
// (spec/bindings/mcp.md [MCPB-CDX-006]): it exists to learn what the app-server does with
// the member, so that the spec's UNVERIFIED label can be replaced by an observation.
//
// Transport: spawns `codex app-server proxy` (a raw stdio<->UDS byte relay to the daemon's
// control socket) once per connection, does the HTTP/1.1 Upgrade and the RFC 6455 framing
// itself, one JSON-RPC message per text frame. Shapes: `codex app-server
// generate-json-schema --experimental` at the observed Codex version.
//
// Hard limits, enforced in this file:
//   - It sends only the methods in ALLOWED_METHODS. turn/steer, any login or account method,
//     thread/list, thread/read and every other method are not on the list.
//   - Every request that names a threadId names a thread this process started (OWN).
//   - It never answers a server->client request (an approval or an elicitation): it logs it,
//     leaves it, and stops the case that was running (observation `case-stopped`).
//   - A frame about a thread this process did not start is not recorded: the transcript holds
//     a stub in its place. thread/loaded/list ids that are not its own are replaced.
//   - It reads no file. It reads no credential and asks no credential store for anything; the
//     daemon serves every model turn from its own saved sign-in.
//   - It archives the threads it started (S3 did the same), best effort, on EVERY exit path: normal
//     end, an error, a proxy that fails, SIGINT/SIGTERM, and its own deadline (the 4th argument, set by
//     the scenario shorter than its hard kill). A request with no answer in 60 s is answered with an
//     error here and not re-sent; an upgrade is bounded to 30 s.
// Every frame, both directions, is appended to transcript.jsonl beside this script as
// {t, mode, direction, payload}; `mode` names the connection. Each observation is also
// appended, with direction `observation`. Every wait is bounded and event-gated: the only
// fixed waits are the observation windows of the cases that check that nothing happens.

import { spawn } from 'node:child_process';
import { appendFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { randomUUID, randomBytes } from 'node:crypto';

const HERE = dirname(fileURLToPath(import.meta.url));
const TRANSCRIPT = join(HERE, 'transcript.jsonl');
const [, , mode, arg1, arg2] = process.argv;

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const log = (label, direction, payload) =>
  appendFileSync(TRANSCRIPT, JSON.stringify({ t: new Date().toISOString(), mode: label, direction, payload }) + '\n');
const status = (line) => console.log(line);

// The only methods this client sends. Not on it, so never sent: turn/steer, account/login/*,
// thread/list, thread/read, thread/fork, thread/inject_items, thread/settings/update, ...
const ALLOWED_METHODS = [
  'initialize',
  'thread/start',
  'thread/resume',
  'thread/unsubscribe',
  'thread/archive',
  'thread/loaded/list',
  'turn/start',
  'turn/interrupt',
  'thread/queue/add',
  'thread/queue/list',
  'thread/queue/update',
  'thread/queue/delete',
  'thread/queue/reorder',
];

// Threads this process started, and the ones it has archived.
const OWN = new Set();
const archived = new Set();
// thread/start requests awaiting an answer, over all connections: a frame about a thread that
// is not (yet) known is held until the answer names it.
let pendingStarts = 0;
const held = [];
// The first server->client request seen in the running case (an approval or an elicitation).
let blocked = null;
const stopOnBlock = { on: true };
const connections = new Set();

class CaseStop extends Error {}

const checkBlocked = () => {
  if (deadlineHit && stopOnBlock.on) throw new CaseStop('the client\'s own deadline was reached; the case stops and the threads are archived');
  if (blocked && stopOnBlock.on) throw new CaseStop(`server request ${blocked.method} (id ${JSON.stringify(blocked.id)}) was not answered; the case stops`);
};

// Bounds. A request that gets no answer in REQUEST_MS is answered here with an error (the
// request is not re-sent); an upgrade that does not finish in UPGRADE_MS fails the connection.
const REQUEST_MS = 60000;
const UPGRADE_MS = 30000;
const ARCHIVE_MS = 15000; // per thread
const CLEANUP_MS = 90000; // the whole cleanup
// The scenario passes a deadline shorter than its own hard kill, so that this process stops the
// running case, archives its threads and exits by itself.
let deadlineHit = false;

// Every exit path ends here: archive the threads this process started (bounded), then exit.
let finishing = null;
function finish(code, why = null) {
  finishing ??= (async () => {
    if (why) console.error(why);
    stopOnBlock.on = false;
    blocked = null;
    await Promise.race([archiveOwn().catch((e) => console.error(`[cleanup failed] ${e.message}`)), sleep(CLEANUP_MS)]);
    process.exit(code);
  })();
  return finishing;
}
for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => void finish(143, `[signal] ${sig}`));

const frameThreadId = (msg) => msg?.params?.threadId ?? msg?.params?.thread?.id ?? null;
const stubOf = (msg) => ({ method: msg.method, params: { threadId: '<NOT-OWN-THREAD>' }, _g7: 'about a thread this client did not start; its content was not recorded' });

// The transcript decision for one daemon->client notification or request.
function logInbound(label, msg, { final = false } = {}) {
  const tid = frameThreadId(msg);
  if (tid && !OWN.has(tid)) {
    if (pendingStarts > 0 && !final) {
      held.push({ label, msg });
      return;
    }
    log(label, 'daemon->client', stubOf(msg));
    return;
  }
  log(label, 'daemon->client', msg);
}
function flushHeld() {
  if (pendingStarts > 0) return;
  while (held.length) {
    const h = held.shift();
    logInbound(h.label, h.msg, { final: true });
  }
}

// One daemon connection: its own proxy process, its own request ids, its own event list.
function connect(label) {
  let upgraded = false;
  const proc = spawn('codex', ['app-server', 'proxy'], { stdio: ['pipe', 'pipe', 'pipe'], shell: true });
  proc.stderr.on('data', (d) => log(label, 'proxy-stderr', d.toString()));
  proc.on('exit', (code) => {
    if (!upgraded && !conn.closed) void finish(3, `[proxy exited before the upgrade] ${label} code ${code}`);
  });
  const conn = { label, proc, events: [], pending: new Map(), nextId: 0, waiters: new Set(), closed: false };
  connections.add(conn);

  const frame = (opcode, payload) => {
    const mask = randomBytes(4);
    let header;
    if (payload.length < 126) header = Buffer.from([0x80 | opcode, 0x80 | payload.length]);
    else if (payload.length < 65536) { header = Buffer.alloc(4); header[0] = 0x80 | opcode; header[1] = 0x80 | 126; header.writeUInt16BE(payload.length, 2); }
    else { header = Buffer.alloc(10); header[0] = 0x80 | opcode; header[1] = 0x80 | 127; header.writeBigUInt64BE(BigInt(payload.length), 2); }
    const masked = Buffer.alloc(payload.length);
    for (let i = 0; i < payload.length; i++) masked[i] = payload[i] ^ mask[i % 4];
    if (!conn.closed) proc.stdin.write(Buffer.concat([header, mask, masked]));
  };
  const sendJson = (msg) => {
    log(label, 'client->daemon', msg);
    frame(0x1, Buffer.from(JSON.stringify(msg), 'utf8'));
  };
  const guard = (method, params) => {
    if (!ALLOWED_METHODS.includes(method)) throw new Error(`refusing to send ${method}: not a method this client may send`);
    const tid = params?.threadId;
    if (tid !== undefined && !OWN.has(tid)) throw new Error(`refusing to send ${method} for a thread this client did not start`);
  };

  conn.request = (method, params) => {
    guard(method, params);
    const id = conn.nextId++;
    if (method === 'thread/start') pendingStarts += 1;
    sendJson({ jsonrpc: '2.0', id, method, params });
    return new Promise((resolve) => {
      const timer = setTimeout(() => {
        conn.pending.delete(id);
        if (method === 'thread/start') pendingStarts -= 1;
        resolve({ error: { code: null, message: `no answer in ${REQUEST_MS} ms`, timedOut: true } });
      }, REQUEST_MS);
      conn.pending.set(id, { resolve: (r) => { clearTimeout(timer); resolve(r); }, method });
    }).then((r) => {
      checkBlocked();
      return r;
    });
  };
  conn.notify = (method, params) => sendJson({ jsonrpc: '2.0', method, params });
  // Resolve with the first event (from index `from` on) that matches, or null at the deadline
  // (or when a server request has stopped the case: the check below then throws).
  conn.waitFor = (pred, ms, from = 0) =>
    new Promise((resolve) => {
      const hit = conn.events.slice(from).find(pred);
      if (hit) return resolve(hit);
      const w = { pred, resolve: (v) => { clearTimeout(w.timer); conn.waiters.delete(w); resolve(v); } };
      w.timer = setTimeout(() => w.resolve(null), ms);
      conn.waiters.add(w);
    }).then((v) => {
      checkBlocked();
      return v;
    });
  conn.close = async () => {
    if (conn.closed) return;
    try { frame(0x8, Buffer.alloc(0)); } catch {}
    conn.closed = true;
    connections.delete(conn);
    try { proc.stdin.end(); } catch {}
    await Promise.race([new Promise((r) => proc.once('exit', r)), sleep(3000)]);
    try { proc.kill(); } catch {}
  };

  let onUpgraded;
  conn.upgraded = new Promise((r) => (onUpgraded = r));
  proc.stdin.write(
    'GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n' +
      `Sec-WebSocket-Key: ${randomBytes(16).toString('base64')}\r\nSec-WebSocket-Version: 13\r\n\r\n`,
  );
  let raw = Buffer.alloc(0);
  let fragments = [];
  proc.stdout.on('data', (chunk) => {
    raw = Buffer.concat([raw, chunk]);
    if (!upgraded) {
      const end = raw.indexOf('\r\n\r\n');
      if (end === -1) return;
      const head = raw.subarray(0, end).toString('utf8');
      log(label, 'handshake', head);
      raw = raw.subarray(end + 4);
      if (!/^HTTP\/1\.1 101/.test(head)) { void finish(3, `[upgrade failed] ${label}\n${head}`); return; }
      upgraded = true;
      onUpgraded();
    }
    while (raw.length >= 2) {
      const fin = (raw[0] & 0x80) !== 0;
      const opcode = raw[0] & 0x0f;
      let len = raw[1] & 0x7f;
      let off = 2;
      if (len === 126) { if (raw.length < 4) return; len = raw.readUInt16BE(2); off = 4; }
      else if (len === 127) { if (raw.length < 10) return; len = Number(raw.readBigUInt64BE(2)); off = 10; }
      if (raw.length < off + len) return;
      const data = raw.subarray(off, off + len);
      raw = raw.subarray(off + len);
      if (opcode === 0x9) { frame(0xA, data); continue; } // ping -> pong
      if (opcode === 0x8) { log(label, 'ws-close', data.toString('utf8')); continue; }
      if (opcode === 0xA) continue;
      fragments.push(data);
      if (!fin) continue;
      const line = Buffer.concat(fragments).toString('utf8');
      fragments = [];
      let msg;
      try { msg = JSON.parse(line); } catch { log(label, 'unparsed', line); continue; }
      if (msg.id !== undefined && !msg.method && conn.pending.has(msg.id)) {
        const p = conn.pending.get(msg.id);
        conn.pending.delete(msg.id);
        if (p.method === 'thread/start') {
          pendingStarts -= 1;
          const id = msg.result?.thread?.id;
          if (typeof id === 'string') OWN.add(id);
        }
        // Ids of threads this process did not start are not recorded.
        if (p.method === 'thread/loaded/list' && Array.isArray(msg.result?.data)) {
          log(label, 'daemon->client', { ...msg, result: { ...msg.result, data: msg.result.data.map((id) => (OWN.has(id) ? id : '<NOT-OWN-THREAD>')) } });
        } else log(label, 'daemon->client', msg);
        p.resolve(msg);
        flushHeld();
      } else if (msg.method) {
        logInbound(label, msg);
        conn.events.push(msg);
        if (msg.id !== undefined) {
          // A server->client request (an approval, an elicitation): never answered.
          status(`[server-request ignored; never answered by this client] ${label} ${msg.method}`);
          blocked ??= { method: msg.method, id: msg.id, connection: label };
          for (const c of connections) for (const w of [...c.waiters]) w.resolve(null);
        }
        for (const w of [...conn.waiters]) if (w.pred(msg)) w.resolve(msg);
      }
    }
  });
  return conn;
}

async function open(label, { experimentalApi = true } = {}) {
  const c = connect(label);
  const up = await Promise.race([c.upgraded.then(() => true), sleep(UPGRADE_MS).then(() => false)]);
  if (!up) {
    await c.close();
    throw new Error(`${label}: no WebSocket upgrade in ${UPGRADE_MS} ms`);
  }
  const capabilities = experimentalApi ? { experimentalApi: true } : {};
  const init = await c.request('initialize', { clientInfo: { name: 'oac_g7_recheck', title: 'OAC G7 live re-check (throwaway)', version: '0.0.1' }, capabilities });
  if (init.error) throw new Error(`${label}: initialize failed ${JSON.stringify(init.error)}`);
  c.notify('initialized', {});
  return c;
}

const text = (t) => [{ type: 'text', text: t }];
const textOf = (content) => (Array.isArray(content) ? content.map((x) => (typeof x?.text === 'string' ? x.text : '')).join('') : '');
const queueAdd = (c, threadId, t, extra = {}) => {
  const clientUserMessageId = randomUUID();
  return c.request('thread/queue/add', { threadId, clientUserMessageId, input: text(t), ...extra }).then((r) => ({ r, clientUserMessageId, sentText: t }));
};
const isFor = (threadId) => (m) => m.params?.threadId === threadId;
const turnStarted = (threadId, turnId = null) => (m) => m.method === 'turn/started' && isFor(threadId)(m) && (!turnId || m.params?.turn?.id === turnId);
const turnCompleted = (threadId, turnId) => (m) => m.method === 'turn/completed' && isFor(threadId)(m) && m.params?.turn?.id === turnId;
const userItemWithClientId = (threadId, clientId) => (m) => m.method === 'item/started' && isFor(threadId)(m) && m.params?.item?.type === 'userMessage' && m.params.item.clientId === clientId;
const errOf = (r) => (r.error ? { code: r.error.code ?? null, message: String(r.error.message ?? '').slice(0, 300) } : null);
// The settings a thread/start or thread/resume result reports.
const settingsOf = (r) => {
  const x = r.result;
  if (!x) return null;
  return { approvalPolicy: x.approvalPolicy ?? null, sandbox: x.sandbox ?? null, model: x.model ?? null, reasoningEffort: x.reasoningEffort ?? null, threadStatus: x.thread?.status ?? null };
};

const BUSY = 'OAC G7 recheck busy turn: write a numbered list of 40 distinct one-sentence facts about lighthouses. Do not use any tools.';
const reply = (words) => `OAC G7 recheck: reply with exactly the words ${words}. Do not use any tools.`;
const TURN_MS = 300000;
// The "nothing happens" window: longer than two ticks of the daemon's 10 s queue watcher
// (ext/queue service.rs). The scenario passes it; a test may pass a shorter one.
let QUIET_MS = 25000;
const UNLOAD_MS = 150000; // the daemon unloads an unsubscribed idle thread after 60 s by default

const results = [];
function obs(name, observed) {
  results.push({ name, observed });
  log('g7-observation', 'observation', { name, observed });
  status(`[case] ${JSON.stringify({ name, observed }).slice(0, 400)}`);
}

// The setting row 73 sends: the approval policy. Chosen to differ from the thread's own, so
// that a reported value says which one the app-server holds: `untrusted` (ask before running
// anything not trusted) unless the thread already has it. No turn follows the override.
const overrideFor = (current) => (current === 'untrusted' ? 'on-request' : 'untrusted');

async function startThread(c, cwd, tag) {
  const s = await c.request('thread/start', { cwd });
  const id = s.result?.thread?.id;
  obs(`${tag}-thread-start`, { error: errOf(s), settings: settingsOf(s), ephemeral: s.result?.thread?.ephemeral ?? null });
  if (!id) throw new Error(`${tag}: thread/start returned no thread id`);
  return { id, start: s };
}

// turn/start with a low reasoning effort (TurnStartParams.effort, a string the model advertises), so the
// turns cost little. If the daemon refuses the member, the refusal is recorded once and the turn is
// sent again without it (a refused request started nothing; a request that got no answer is not re-sent).
let EFFORT = 'low';
async function turnStart(c, threadId, input) {
  let t = await c.request('turn/start', EFFORT ? { threadId, input, effort: EFFORT } : { threadId, input });
  if (t.error && !t.error.timedOut && EFFORT) {
    obs('effort-rejected', { effort: EFFORT, error: errOf(t) });
    EFFORT = null;
    t = await c.request('turn/start', { threadId, input });
  }
  return t;
}

// A turn that started after event index `from` and has not completed (a dispatch that came late):
// wait for it, and record it, rather than sending turn/start into it. -> turn ids, or null
async function settleIdle(c, threadId, from, tag) {
  const ev = c.events.slice(from);
  const running = ev.filter(turnStarted(threadId)).map((m) => m.params.turn.id).filter((id) => !ev.some(turnCompleted(threadId, id)));
  if (!running.length) return null;
  for (const id of running) await c.waitFor(turnCompleted(threadId, id), TURN_MS, from);
  obs(`${tag}-late-dispatch`, { turnIds: running });
  return running;
}

// One minimal turn on the connection that holds the thread. -> { turnId, status, doneIdx }
async function runTurn(c, threadId, words) {
  const from = c.events.length;
  const t = await turnStart(c, threadId, text(reply(words)));
  const tid = t.result?.turn?.id;
  if (!tid) return { turnId: null, status: null, doneIdx: null, error: errOf(t) };
  const done = await c.waitFor(turnCompleted(threadId, tid), TURN_MS, from);
  return { turnId: tid, status: done?.params?.turn?.status ?? null, doneIdx: done ? c.events.indexOf(done) : null, error: null };
}

// A queued message's turn: the userMessage item carrying clientId = clientUserMessageId, then
// that turn's turn/completed. -> { ran, ... }
async function queuedTurn(c, threadId, clientId, from, sentText = null, ms = TURN_MS) {
  const item = await c.waitFor(userItemWithClientId(threadId, clientId), ms, from);
  if (!item) return { ran: false };
  const turnId = item.params.turnId;
  const done = await c.waitFor(turnCompleted(threadId, turnId), ms, from);
  const userText = textOf(item.params.item.content);
  return {
    ran: true,
    turnId,
    completed: done?.params?.turn?.status ?? null,
    userText,
    textMatches: sentText === null ? null : userText === sentText,
    startedIdx: c.events.indexOf(item),
    completedIdx: done ? c.events.indexOf(done) : null,
  };
}

// A busy turn, started: -> its id and the event index to wait from.
async function startBusyTurn(c, threadId, tag) {
  const from = c.events.length;
  const t = await turnStart(c, threadId, text(BUSY));
  const tid = t.result?.turn?.id;
  obs(`${tag}-busy-turn-start`, { error: errOf(t), turnId: tid ?? null });
  const started = tid && (await c.waitFor(turnStarted(threadId, tid), 30000, from));
  if (!started) throw new Error(`${tag}: the busy turn did not start`);
  return { tid, from };
}
const waitFirstDelta = (c, threadId, tid, from) => c.waitFor((m) => m.method === 'item/agentMessage/delta' && isFor(threadId)(m) && m.params?.turnId === tid, 60000, from);

const addObs = (q) => ({ accepted: !q.r.error, error: errOf(q.r), queuedId: q.r.result?.queuedSubmission?.id ?? null });

// a1: items already queued when a turn is interrupted. Two adds during a running turn, then
// turn/interrupt, then the quiet window; then an uninterrupted turn, after which the queued
// items run, one per idle.
async function caseA1(cwd) {
  const main = await open('a1-main');
  const T = await startThread(main, cwd, 'a1');
  const { tid, from } = await startBusyTurn(main, T.id, 'a1');
  await waitFirstDelta(main, T.id, tid, from);
  const q1 = await queueAdd(main, T.id, reply('OAC G7 A1 QUEUED 1'));
  const q2 = await queueAdd(main, T.id, reply('OAC G7 A1 QUEUED 2'));
  obs('a1-add-1', addObs(q1));
  obs('a1-add-2', addObs(q2));
  const i = await main.request('turn/interrupt', { threadId: T.id, turnId: tid });
  obs('a1-interrupt', { error: errOf(i) });
  const done = await main.waitFor(turnCompleted(T.id, tid), 60000, from);
  obs('a1-interrupt-completed', { status: done?.params?.turn?.status ?? null });
  const qFrom = done ? main.events.indexOf(done) + 1 : main.events.length;
  const early = await main.waitFor(turnStarted(T.id), QUIET_MS, qFrom);
  obs('a1-dispatch-within-quiet-window', { dispatched: !!early, quietMs: QUIET_MS });
  let next = null;
  if (early) await main.waitFor(turnCompleted(T.id, early.params.turn.id), TURN_MS, qFrom);
  else {
    await settleIdle(main, T.id, qFrom, 'a1');
    next = await runTurn(main, T.id, 'OAC G7 A1 NEXT TURN');
    obs('a1-next-turn', { status: next.status, error: next.error });
  }
  const first = await queuedTurn(main, T.id, q1.clientUserMessageId, qFrom, q1.sentText);
  obs('a1-first-queued-turn', { ...first, afterNextTurn: first.ran && next?.doneIdx != null ? first.startedIdx > next.doneIdx : null });
  const second = await queuedTurn(main, T.id, q2.clientUserMessageId, qFrom, q2.sentText);
  obs('a1-second-queued-turn', { ...second, afterNextTurn: second.ran && next?.doneIdx != null ? second.startedIdx > next.doneIdx : null });
  obs('a1-queued-turns', {
    distinct: first.ran && second.ran ? first.turnId !== second.turnId : null,
    inOrder: first.ran && second.ran ? first.startedIdx < second.startedIdx : null,
    onePerIdle: first.ran && second.ran && first.completedIdx != null ? second.startedIdx > first.completedIdx : null,
  });
}

// d, a2 and c on one thread of its own.
async function caseDAC(cwd) {
  const main = await open('dac-main');
  const T = await startThread(main, cwd, 'dac');
  const first = await runTurn(main, T.id, 'OAC G7 DAC FIRST');
  obs('dac-first-turn', { status: first.status, error: first.error });

  // d. An add to the idle thread (its last turn completed), carrying a member beyond
  //    threadId, clientUserMessageId and input.
  {
    const from = main.events.length;
    const q = await queueAdd(main, T.id, reply('OAC G7 EXTRA MEMBER'), { oacG7ExtraMember: 'an extra member' });
    obs('d-add', { ...addObs(q), extraMember: 'oacG7ExtraMember' });
    if (!q.r.error) obs('d-turn', await queuedTurn(main, T.id, q.clientUserMessageId, from, q.sentText));
  }

  // a2. turn/interrupt, then an add to the thread whose last turn was interrupted.
  {
    const { tid, from } = await startBusyTurn(main, T.id, 'a2');
    await waitFirstDelta(main, T.id, tid, from);
    const i = await main.request('turn/interrupt', { threadId: T.id, turnId: tid });
    obs('a2-interrupt', { error: errOf(i) });
    const done = await main.waitFor(turnCompleted(T.id, tid), 60000, from);
    obs('a2-interrupt-completed', { status: done?.params?.turn?.status ?? null });
    const qFrom = done ? main.events.indexOf(done) + 1 : main.events.length;
    const q = await queueAdd(main, T.id, reply('OAC G7 A2 AFTER INTERRUPT'));
    obs('a2-add', addObs(q));
    const early = await main.waitFor(turnStarted(T.id), QUIET_MS, qFrom);
    obs('a2-dispatch-within-quiet-window', { dispatched: !!early, quietMs: QUIET_MS });
    let next = null;
    if (early) await main.waitFor(turnCompleted(T.id, early.params.turn.id), TURN_MS, qFrom);
    else {
      await settleIdle(main, T.id, qFrom, 'a2');
      next = await runTurn(main, T.id, 'OAC G7 A2 NEXT TURN');
      obs('a2-next-turn', { status: next.status, error: next.error });
    }
    const qt = await queuedTurn(main, T.id, q.clientUserMessageId, qFrom, q.sentText);
    obs('a2-queued-turn', { ...qt, afterNextTurn: qt.ran && next?.doneIdx != null ? qt.startedIdx > next.doneIdx : null });
  }

  // c. An add to a thread that is not loaded: unsubscribe, wait for the daemon to unload it,
  //    add, check it stays queued, then load it from a second connection.
  {
    const uFrom = main.events.length;
    const u = await main.request('thread/unsubscribe', { threadId: T.id });
    obs('c-unsubscribe', { error: errOf(u) });
    const closed = await main.waitFor((m) => m.method === 'thread/closed' && isFor(T.id)(m), UNLOAD_MS, uFrom);
    obs('c-thread-closed', { closed: !!closed, waitedMs: closed ? null : UNLOAD_MS });
    const l1 = await main.request('thread/loaded/list', {});
    obs('c-loaded-before-add', { loaded: Array.isArray(l1.result?.data) ? l1.result.data.includes(T.id) : null, error: errOf(l1) });
    const from = main.events.length;
    const q = await queueAdd(main, T.id, reply('OAC G7 C UNLOADED'));
    obs('c-add', addObs(q));
    // This connection unsubscribed, so a turn would show here only through notifications the
    // daemon sends every connection; thread/loaded/list below is the check that counts.
    const early = await main.waitFor((m) => isFor(T.id)(m) && m.method !== 'thread/queue/changed', QUIET_MS, from);
    obs('c-events-within-quiet-window', { method: early ? early.method : null, quietMs: QUIET_MS });
    const l2 = await main.request('thread/loaded/list', {});
    obs('c-loaded-after-add', { loaded: Array.isArray(l2.result?.data) ? l2.result.data.includes(T.id) : null, error: errOf(l2) });
    const reload = await open('c-reload');
    const r = await reload.request('thread/resume', { threadId: T.id, excludeTurns: true });
    obs('c-resume', { error: errOf(r), settings: settingsOf(r) });
    obs('c-queued-turn', await queuedTurn(reload, T.id, q.clientUserMessageId, 0, q.sentText, 120000));
  }
}

// b. Another daemon client lists, updates, reorders and deletes the items held in a queue.
//    The items are held by an interrupted turn (row 66 (a)), so nothing dispatches while they
//    are managed. The connection that manages them never started or resumed the thread.
async function caseB(cwd) {
  const main = await open('b-main');
  const T = await startThread(main, cwd, 'b');
  const { tid, from } = await startBusyTurn(main, T.id, 'b');
  await waitFirstDelta(main, T.id, tid, from);
  const q1 = await queueAdd(main, T.id, reply('OAC G7 B ITEM 1'));
  const q2 = await queueAdd(main, T.id, reply('OAC G7 B ITEM 2'));
  const q3 = await queueAdd(main, T.id, reply('OAC G7 B ITEM 3'));
  const updatedText = reply('OAC G7 B ITEM 2 UPDATED');
  obs('b-adds', { accepted: [q1, q2, q3].map((q) => !q.r.error), ids: [q1, q2, q3].map((q) => q.r.result?.queuedSubmission?.id ?? null), texts: [q1, q2, q3].map((q) => q.sentText) });
  const i = await main.request('turn/interrupt', { threadId: T.id, turnId: tid });
  obs('b-interrupt', { error: errOf(i) });
  const done = await main.waitFor(turnCompleted(T.id, tid), 60000, from);
  obs('b-interrupt-completed', { status: done?.params?.turn?.status ?? null });
  const heldFrom = done ? main.events.indexOf(done) + 1 : main.events.length;

  const other = await open('b-other');
  const listItems = (r) => (Array.isArray(r.result?.data) ? r.result.data.map((s) => ({ id: s.id, clientUserMessageId: s.clientUserMessageId, text: textOf(s.input) })) : null);
  const l1 = await other.request('thread/queue/list', { threadId: T.id });
  obs('b-list-before', { error: errOf(l1), items: listItems(l1) });
  const ids = [q1, q2, q3].map((q) => q.r.result?.queuedSubmission?.id);
  const upd = await other.request('thread/queue/update', { threadId: T.id, queuedSubmissionId: ids[1], input: text(updatedText) });
  obs('b-update', { error: errOf(upd), id: upd.result?.queuedSubmission?.id ?? null, sameId: upd.result?.queuedSubmission?.id === ids[1], text: textOf(upd.result?.queuedSubmission?.input) });
  // If the update gave the item a new id, the reorder uses it.
  const idsNow = [ids[0], upd.result?.queuedSubmission?.id ?? ids[1], ids[2]];
  const reo = await other.request('thread/queue/reorder', { threadId: T.id, queuedSubmissionIds: [idsNow[2], idsNow[1], idsNow[0]] });
  obs('b-reorder', { error: errOf(reo), requestedOrder: ['item 3', 'item 2', 'item 1'] });
  const del = await other.request('thread/queue/delete', { threadId: T.id, queuedSubmissionId: idsNow[0] });
  obs('b-delete', { error: errOf(del), deleted: del.result?.deleted ?? null });
  const l2 = await other.request('thread/queue/list', { threadId: T.id });
  const itemsAfter = listItems(l2);
  obs('b-list-after', { error: errOf(l2), items: itemsAfter });
  obs('b-held-during-management', { turnStartedMeanwhile: main.events.slice(heldFrom).some(turnStarted(T.id)), queueChangedOnOwner: main.events.slice(heldFrom).filter((m) => m.method === 'thread/queue/changed' && isFor(T.id)(m)).length });

  // An uninterrupted turn; then what dispatches, one item per idle, head first.
  await settleIdle(main, T.id, heldFrom, 'b');
  const next = await runTurn(main, T.id, 'OAC G7 B NEXT TURN');
  obs('b-next-turn', { status: next.status, error: next.error });
  const expected = itemsAfter ? itemsAfter.length : 2;
  const dispatched = [];
  let cursor = next.doneIdx != null ? next.doneIdx + 1 : main.events.length;
  while (dispatched.length < expected + 1 && dispatched.length < 4) {
    // Up to the number of items the queue listed, wait for a turn; one more, only as long as the quiet window.
    const it = await main.waitFor((m) => m.method === 'item/started' && isFor(T.id)(m) && m.params?.item?.type === 'userMessage', dispatched.length < expected ? TURN_MS : QUIET_MS, cursor);
    if (!it) break;
    const turnId = it.params.turnId;
    const d = await main.waitFor(turnCompleted(T.id, turnId), TURN_MS, cursor);
    dispatched.push({ text: textOf(it.params.item.content), clientUserMessageId: it.params.item.clientId ?? null, turnId, status: d?.params?.turn?.status ?? null });
    cursor = main.events.indexOf(d ?? it) + 1;
  }
  obs('b-dispatched', {
    count: dispatched.length,
    texts: dispatched.map((d) => d.text),
    expectedTexts: [reply('OAC G7 B ITEM 3'), updatedText],
    deletedItemRan: dispatched.some((d) => d.text === q1.sentText),
    quietMs: QUIET_MS,
  });
}

// Row 73. A thread/resume that carries one setting override (approvalPolicy), in three states of
// the thread, because the app-server's behaviour depends on them (rust-v0.166.0
// codex-rs/app-server/src/request_processors/thread_processor.rs L4697-L4748: an override that differs
// from a loaded thread's settings is applied by shutting the thread down and resuming it cold ONLY if
// the thread is idle and has no subscriber; otherwise it is ignored with a warning):
//   l  loaded and idle, with subscribers (two connections hold it)
//   w  loaded and idle, with NO subscriber (the one subscriber unsubscribed; the override is sent
//      before the daemon's unload delay of about 60 s ends)
//   u  not loaded (the control)
// Each is followed by a resume without an override, from a connection of its own, as the readback.
// Each thread needs one minimal turn first: a resume needs the thread's stored history, which
// exists from its first user message on.
async function caseProbe(cwd) {
  const main = await open('p-main');
  const loadedHas = async (c, id) => {
    const r = await c.request('thread/loaded/list', {});
    return Array.isArray(r.result?.data) ? r.result.data.includes(id) : null;
  };

  // l. Loaded, idle, with subscribers.
  const L = await startThread(main, cwd, 'l');
  const baselinePolicy = L.start.result?.approvalPolicy ?? null;
  const O = overrideFor(baselinePolicy);
  obs('override-chosen', { member: 'approvalPolicy', value: O, threadHas: baselinePolicy });
  const turn = await runTurn(main, L.id, 'OAC G7 PROBE LOADED');
  obs('l-first-turn', { status: turn.status, error: turn.error });
  obs('l-loaded', { loaded: await loadedHas(main, L.id) });
  const sub = await open('p-sub');
  const r0 = await sub.request('thread/resume', { threadId: L.id, excludeTurns: true });
  obs('l-resume-baseline', { sent: ['threadId', 'excludeTurns'], error: errOf(r0), settings: settingsOf(r0) });
  obs('l-subscribers', { connections: ['p-main (thread/start subscribes it)', 'p-sub (thread/resume)'], count: 2 });
  const ovr = await open('p-ovr');
  const marks = new Map([main, sub, ovr].map((c) => [c.label, c.events.length]));
  const r1 = await ovr.request('thread/resume', { threadId: L.id, excludeTurns: true, approvalPolicy: O });
  obs('l-resume-override', { sent: ['threadId', 'excludeTurns', 'approvalPolicy'], approvalPolicy: O, error: errOf(r1), settings: settingsOf(r1) });
  const isSettingsUpdate = (m) => m.method === 'thread/settings/updated' && isFor(L.id)(m);
  const heard = await Promise.all([main, sub, ovr].map(async (c) => ({ connection: c.label, hit: await c.waitFor(isSettingsUpdate, QUIET_MS, marks.get(c.label)) })));
  obs('l-settings-updated-notification', { quietMs: QUIET_MS, seen: heard.filter((h) => h.hit).map((h) => ({ connection: h.connection, approvalPolicy: h.hit.params?.threadSettings?.approvalPolicy ?? null })) });
  const after = await open('p-after');
  const r2 = await after.request('thread/resume', { threadId: L.id, excludeTurns: true });
  obs('l-resume-readback', { sent: ['threadId', 'excludeTurns'], error: errOf(r2), settings: settingsOf(r2) });

  // w. Loaded, idle, no subscriber. The connections that will send the resumes are opened BEFORE the
  //    unsubscribe, so that the override reaches the daemon well inside its unload delay.
  const W = await startThread(main, cwd, 'w');
  const wturn = await runTurn(main, W.id, 'OAC G7 PROBE NO SUBSCRIBER');
  obs('w-first-turn', { status: wturn.status, error: wturn.error });
  const wovr = await open('p-wovr');
  const wafter = await open('p-wafter');
  const wun = await main.request('thread/unsubscribe', { threadId: W.id });
  obs('w-unsubscribe', { error: errOf(wun) });
  obs('w-subscribers', { connections: [], count: 0, note: 'p-main, the only connection that held the thread, unsubscribed; no other connection resumed it' });
  const wLoaded = await loadedHas(wovr, W.id);
  obs('w-loaded-before-resume', { loaded: wLoaded });
  const wMark = new Map([main, wovr, wafter].map((c) => [c.label, c.events.length]));
  const r5 = await wovr.request('thread/resume', { threadId: W.id, excludeTurns: true, approvalPolicy: O });
  obs('w-resume-override', { sent: ['threadId', 'excludeTurns', 'approvalPolicy'], approvalPolicy: O, error: errOf(r5), settings: settingsOf(r5) });
  await sleep(Math.min(QUIET_MS, 5000));
  const wMethods = [...new Set([main, wovr, wafter].flatMap((c) => c.events.slice(wMark.get(c.label)).filter(isFor(W.id)).map((m) => m.method)))];
  obs('w-events-after-override', { windowMs: Math.min(QUIET_MS, 5000), methods: wMethods });
  const r6 = await wafter.request('thread/resume', { threadId: W.id, excludeTurns: true });
  obs('w-resume-readback', { sent: ['threadId', 'excludeTurns'], error: errOf(r6), settings: settingsOf(r6) });

  // u. The control: not loaded.
  const U = await startThread(main, cwd, 'u');
  const uturn = await runTurn(main, U.id, 'OAC G7 PROBE UNLOADED');
  obs('u-first-turn', { status: uturn.status, error: uturn.error });
  const uFrom = main.events.length;
  const un = await main.request('thread/unsubscribe', { threadId: U.id });
  obs('u-unsubscribe', { error: errOf(un) });
  const closed = await main.waitFor((m) => m.method === 'thread/closed' && isFor(U.id)(m), UNLOAD_MS, uFrom);
  obs('u-thread-closed', { closed: !!closed, waitedMs: closed ? null : UNLOAD_MS });
  obs('u-loaded-before-resume', { loaded: await loadedHas(main, U.id) });
  obs('u-subscribers', { connections: [], count: 0, loaded: false });
  const uovr = await open('p-uovr');
  const r3 = await uovr.request('thread/resume', { threadId: U.id, excludeTurns: true, approvalPolicy: O });
  obs('u-resume-override', { sent: ['threadId', 'excludeTurns', 'approvalPolicy'], approvalPolicy: O, error: errOf(r3), settings: settingsOf(r3) });
  const uafter = await open('p-uafter');
  const r4 = await uafter.request('thread/resume', { threadId: U.id, excludeTurns: true });
  obs('u-resume-readback', { sent: ['threadId', 'excludeTurns'], error: errOf(r4), settings: settingsOf(r4) });
}

const CASES = [
  ['row66', 'a1', caseA1],
  ['row66', 'dac', caseDAC],
  ['row66', 'b', caseB],
  ['row73', 'probe', caseProbe],
];

// Archive the threads this process started, bounded, once each. Used on every exit path.
async function archiveOwn() {
  stopOnBlock.on = false;
  blocked = null;
  const todo = [...OWN].filter((id) => !archived.has(id));
  if (!todo.length) return;
  const c = await open('cleanup');
  for (const id of todo) {
    archived.add(id);
    const a = await Promise.race([c.request('thread/archive', { threadId: id }), sleep(ARCHIVE_MS).then(() => ({ error: { message: `no answer in ${ARCHIVE_MS} ms` } }))]);
    obs('archive', { thread: id, error: errOf(a) });
  }
  await c.close();
}

async function runCases(cwd, set = 'all') {
  if (!['all', 'row66', 'row73'].includes(set)) throw new Error(`unknown case set ${set}`);
  for (const [group, name, fn] of CASES) {
    if (set !== 'all' && set !== group) continue;
    if (deadlineHit) {
      obs('case-skipped', { case: name, reason: 'the deadline was reached' });
      continue;
    }
    blocked = null;
    stopOnBlock.on = true;
    try {
      await fn(cwd);
    } catch (err) {
      if (err instanceof CaseStop) obs('case-stopped', { case: name, reason: err.message, serverRequest: blocked });
      else obs('case-error', { case: name, message: String(err.message).slice(0, 300) });
    } finally {
      stopOnBlock.on = false;
      pendingStarts = 0;
      flushHeld();
      await Promise.all([...connections].map((c) => c.close()));
    }
  }
  if (deadlineHit) obs('deadline-reached', { note: 'the running case was stopped at the client\'s own deadline' });
  await archiveOwn();
  status(`[done] cases: ${results.length} observations; ${OWN.size} thread(s) started`);
}

(async () => {
  if (mode === 'cases') {
    if (!arg1) { console.error('cwd required'); process.exit(2); }
    const quiet = process.argv[5];
    if (quiet !== undefined) {
      if (!/^\d+$/.test(quiet)) { console.error('quietMs must be a whole number of ms'); process.exit(2); }
      QUIET_MS = Number(quiet);
    }
    const deadline = process.argv[6];
    if (deadline !== undefined) {
      if (!/^\d+$/.test(deadline)) { console.error('deadlineMs must be a whole number of ms'); process.exit(2); }
      setTimeout(() => {
        deadlineHit = true;
        for (const c of connections) for (const w of [...c.waiters]) w.resolve(null);
      }, Number(deadline));
    }
    try {
      await runCases(arg1, arg2 ?? 'all');
    } catch (err) {
      console.log(`[error] ${err.message}`);
      await finish(1);
    }
    process.exit(0);
  }
  if (mode === 'hello') {
    try {
      const c = await open('hello');
      await c.close();
    } catch (err) {
      console.log(`[error] ${err.message}`);
      process.exit(1);
    }
    process.exit(0);
  }
  console.error(`unknown mode ${mode}`);
  process.exit(2);
})();
