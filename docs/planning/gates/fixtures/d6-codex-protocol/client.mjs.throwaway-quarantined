#!/usr/bin/env node
// D6 spike (OAC issue #39, subtask T2) — Codex app-server client for protocol fixture capture.
// Quarantined; discarded after the D6 fixtures land (oac-gates "Throwaway rule"). Not repo code.
//
// Base: ../g2-spike/client.mjs (WebSocket-over-UDS via `codex app-server proxy`, HTTP/1.1
// Upgrade + RFC 6455 framing performed by hand because the proxy is a raw byte relay —
// learn.chatgpt.com/docs/app-server; oac-codex-appserver skill "control socket is WebSocket
// over UDS, not JSONL"). `initialize` sends capabilities.experimentalApi:true so experimental
// methods (thread/queue/add) are available on the same connection as stable ones — there is no
// separate "experimental mode" handshake.
//
// This client never reads CODEX_HOME/auth.json, the OS keyring, or any rollout file, and never
// calls turn/steer (ADR-001 boundary 3 / oac-security-work turn/steer note).
//
// Every param object sent is built strictly from the regenerated schema in schema/default/v2
// and schema/experimental/v2 (ThreadStartParams, ThreadResumeParams, TurnStartParams,
// ThreadQueueAddParams) — only fields those schemas define, and only the minimal subset needed
// for each mode. See schema/SCHEMA-META.json for the exact generation this was checked against.
//
// Modes:
//   node client.mjs start [--cwd <dir>] [--watch-turn-completed N] [--timeout-ms MS] [--tid-file <path>]
//     -> thread/start. ThreadStartParams has ZERO required fields (surprise — see D6 report).
//        Sends only { cwd } when --cwd is given, or {} otherwise. Prints the returned threadId
//        and, as soon as the response arrives (before any watching begins), writes it to
//        --tid-file (default tid.txt beside this script) so other steps/processes can read it.
//        T5 retry correction (openai/codex@36650394c5b38c2990ccf2a3457165ca3e9d9726 =
//        rust-v0.157.1, retrieved 2026-09-27): thread/start auto-subscribes the calling
//        connection to turn/*/item/* events (codex-rs/app-server/src/request_processors/
//        thread_processor.rs L1562-1580) — it is no longer true that only thread/resume
//        subscribes (that was the 0.154.0-era G2 finding; re-verify before trusting either
//        claim on a future pin move). With --watch-turn-completed N, this mode now stays
//        connected and behaves exactly like resume's watch loop below (event-driven, no
//        polling); without it, start still exits immediately after printing the response
//        (original behavior, kept for callers that don't need the subscription).
//   node client.mjs resume <threadId> [--exclude-turns] [--watch-turn-completed N] [--timeout-ms MS]
//     -> thread/resume (ThreadResumeParams requires only threadId; excludeTurns is an optional
//        boolean the schema defines — schema/default/v2/ThreadResumeParams.json and
//        schema/experimental/v2/ThreadResumeParams.json both list it under "properties" with
//        only "threadId" in "required" — confirmed present on this kit's checked-in schema
//        before use, per oac-codex-appserver "only use fields the schema defines"). Pass
//        --exclude-turns to send { threadId, excludeTurns: true } (keeps the resume response
//        small when the caller only wants the live event subscription, not history hydration);
//        omit it to send { threadId } alone. A thread/resume subscribes the connection to
//        turn/*/item/* events same as thread/start now does (see correction above) — this
//        remains the call to use for a SECOND connection watching a thread another connection
//        started/holds, per the T5 run sheet. With --watch-turn-completed N, stays open logging
//        every frame until N turn/completed notifications have been observed or --timeout-ms
//        elapses (default 120000) — event-driven (frame handler increments a counter and
//        resolves a promise), never a polling loop.
//   node client.mjs turn <threadId> "<text>"
//     -> turn/start. TurnStartParams requires input + threadId (reused from g2/g5 logic).
//        Sends the request, prints the response, and exits (does not watch for turn/completed —
//        that is conn2/conn1's job via resume/start's --watch-turn-completed).
//   node client.mjs queue <threadId> "<text>"
//     -> thread/queue/add (experimental). Requires clientUserMessageId, input, threadId
//        (reused from g2/g5 logic; ThreadQueueAddParams schema confirms exactly these three).
//        Sends the request, prints the response, and exits (same run-and-exit shape as turn).
//
// Every frame both directions is appended to the JSONL file given by --out (default
// transcript.jsonl beside this script), one JSON object per line, with a leading _meta line.

import { spawn } from 'node:child_process';
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { dirname, join } from 'node:path';
import { randomUUID, randomBytes } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import os from 'node:os';

const HERE = dirname(fileURLToPath(import.meta.url));

function parseArgs(argv) {
  const positional = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) { flags[key] = next; i++; }
      else flags[key] = true;
    } else positional.push(a);
  }
  return { positional, flags };
}

const { positional, flags } = parseArgs(process.argv.slice(2));
const [mode, ...rest] = positional;
const OUT = join(HERE, flags.out || 'transcript.jsonl');
const WATCH_N = flags['watch-turn-completed'] !== undefined ? Number(flags['watch-turn-completed']) : null;
const TIMEOUT_MS = flags['timeout-ms'] !== undefined ? Number(flags['timeout-ms']) : 120000;

function log(direction, payload) {
  appendFileSync(OUT, JSON.stringify({ t: new Date().toISOString(), direction, payload }) + '\n');
}

function schemaSha256Summary() {
  try {
    const meta = JSON.parse(readFileSync(join(HERE, 'schema', 'SCHEMA-META.json'), 'utf8'));
    return {
      default: meta.generation?.default?.treeSha256 ?? null,
      experimental: meta.generation?.experimental?.treeSha256 ?? null,
    };
  } catch {
    return { default: null, experimental: null };
  }
}

function codexVersion() {
  try { return execFileSync('codex', ['--version'], { shell: true }).toString().trim(); }
  catch { return null; }
}

function writeMetaLine() {
  if (!mode) return; // no mode -> nothing to run, nothing to log (arg-parsing dry run)
  const meta = {
    _meta: {
      tool: 'd6-spike/client.mjs',
      codex_version: codexVersion(),
      node_version: process.version,
      os: `${os.platform()} ${os.release()} ${os.arch()}`,
      capture_utc_start: new Date().toISOString(),
      mode,
      schema_sha256: schemaSha256Summary(),
    },
  };
  appendFileSync(OUT, JSON.stringify(meta) + '\n');
}

// ---------------------------------------------------------------------------
// Transport: identical WebSocket-over-UDS-via-proxy mechanics as ../g2-spike/client.mjs and
// ../g5-spike/g5-codex.mjs. Kept verbatim (this is not the part D6 needed to change).
// ---------------------------------------------------------------------------

function startClient() {
  const proc = spawn('codex', ['app-server', 'proxy'], { stdio: ['pipe', 'pipe', 'pipe'], shell: true });
  proc.stderr.on('data', (d) => log('proxy-stderr', d.toString()));

  function wsSendText(str) {
    const payload = Buffer.from(str, 'utf8');
    const mask = randomBytes(4);
    let header;
    if (payload.length < 126) header = Buffer.from([0x81, 0x80 | payload.length]);
    else if (payload.length < 65536) { header = Buffer.alloc(4); header[0] = 0x81; header[1] = 0x80 | 126; header.writeUInt16BE(payload.length, 2); }
    else { header = Buffer.alloc(10); header[0] = 0x81; header[1] = 0x80 | 127; header.writeBigUInt64BE(BigInt(payload.length), 2); }
    const masked = Buffer.alloc(payload.length);
    for (let i = 0; i < payload.length; i++) masked[i] = payload[i] ^ mask[i % 4];
    proc.stdin.write(Buffer.concat([header, mask, masked]));
  }
  function wsSendControl(opcode, data = Buffer.alloc(0)) {
    const mask = randomBytes(4);
    const masked = Buffer.alloc(data.length);
    for (let i = 0; i < data.length; i++) masked[i] = data[i] ^ mask[i % 4];
    proc.stdin.write(Buffer.concat([Buffer.from([0x80 | opcode, 0x80 | data.length]), mask, masked]));
  }

  let nextId = 0;
  const pending = new Map();
  const eventHandlers = new Set();
  function request(method, params) {
    const id = nextId++;
    const msg = { jsonrpc: '2.0', id, method, params };
    log('client->daemon', msg);
    wsSendText(JSON.stringify(msg));
    return new Promise((resolve) => pending.set(id, resolve));
  }
  function notify(method, params) {
    const msg = { jsonrpc: '2.0', method, params };
    log('client->daemon', msg);
    wsSendText(JSON.stringify(msg));
  }
  function onEvent(fn) { eventHandlers.add(fn); return () => eventHandlers.delete(fn); }

  let upgraded = false;
  let onUpgraded;
  const upgradedP = new Promise((r) => (onUpgraded = r));
  const wsKey = randomBytes(16).toString('base64');
  proc.stdin.write(
    'GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n' +
    `Sec-WebSocket-Key: ${wsKey}\r\nSec-WebSocket-Version: 13\r\n\r\n`,
  );

  let raw = Buffer.alloc(0);
  let fragments = [];
  proc.stdout.on('data', (chunk) => {
    raw = Buffer.concat([raw, chunk]);
    if (!upgraded) {
      const end = raw.indexOf('\r\n\r\n');
      if (end === -1) return;
      const head = raw.subarray(0, end).toString('utf8');
      log('handshake', head);
      raw = raw.subarray(end + 4);
      if (!/^HTTP\/1\.1 101/.test(head)) { console.error('[upgrade failed]\n' + head); process.exit(3); }
      upgraded = true;
      onUpgraded();
    }
    while (raw.length >= 2) {
      const fin = (raw[0] & 0x80) !== 0;
      const opcode = raw[0] & 0x0f;
      let len = raw[1] & 0x7f;
      let off = 2;
      if (len === 126) { if (raw.length < 4) return; len = raw.readUInt16BE(2); off = 4; }
      else if (len === 127) { if (raw.length < 10) return; len = Number(raw.readBigUInt64BE(2)); off = 10; }
      if (raw.length < off + len) return;
      const data = raw.subarray(off, off + len);
      raw = raw.subarray(off + len);
      if (opcode === 0x9) { wsSendControl(0xA, data); continue; }       // ping -> pong
      if (opcode === 0x8) { log('ws-close', data.toString('utf8')); continue; }
      if (opcode === 0xA) continue;                                     // pong
      fragments.push(data);
      if (!fin) continue;
      const line = Buffer.concat(fragments).toString('utf8');
      fragments = [];
      let msg;
      try { msg = JSON.parse(line); } catch { log('unparsed', line); continue; }
      log('daemon->client', msg);
      if (msg.id !== undefined && pending.has(msg.id) && (msg.result !== undefined || msg.error !== undefined)) {
        pending.get(msg.id)(msg);
        pending.delete(msg.id);
      } else if (msg.method) {
        console.log(`[event] ${msg.method}${msg.params?.threadId ? ' thread=' + msg.params.threadId : ''}`);
        for (const fn of eventHandlers) fn(msg);
        if (msg.id !== undefined) {
          // Server->client request (e.g. an approval). This spike never answers approvals;
          // a human owns every approval decision (g2/g5 precedent). Logged only.
          console.log(`[server-request ignored; approvals are human-owned] ${msg.method}`);
        }
      }
    }
  });

  const done = (code = 0) => { try { proc.stdin.end(); } catch {} setTimeout(() => process.exit(code), 300); };

  return { proc, request, notify, onEvent, upgradedP, done };
}

async function initClient() {
  const c = startClient();
  await c.upgradedP;
  const init = await c.request('initialize', {
    clientInfo: { name: 'oac_d6_spike', title: 'OAC D6 spike (throwaway)', version: '0.0.1' },
    capabilities: { experimentalApi: true },
  });
  console.log('[initialize]', JSON.stringify(init.result ?? init.error).slice(0, 300));
  c.notify('initialized', {});
  return c;
}

// ---------------------------------------------------------------------------
// Modes
// ---------------------------------------------------------------------------

// Shared event-driven wait loop used by both `start --watch-turn-completed` and
// `resume --watch-turn-completed`. Never polls: a frame handler increments a counter and
// resolves a promise; the only timer is the overall --timeout-ms ceiling.
async function watchTurnCompleted(c) {
  if (WATCH_N === null) {
    console.log('[watching — Ctrl+C to stop]');
    return; // keep process alive; events print/log as they arrive
  }
  console.log(`[watching for ${WATCH_N} turn/completed, timeout ${TIMEOUT_MS}ms]`);
  let completed = 0;
  const reason = await new Promise((resolve) => {
    let timer;
    const unsub = c.onEvent((m) => {
      if (m.method === 'turn/completed') {
        completed++;
        console.log(`[turn/completed ${completed}/${WATCH_N}]`);
        if (completed >= WATCH_N) { clearTimeout(timer); unsub(); resolve('completed'); }
      }
    });
    timer = setTimeout(() => { unsub(); resolve('timeout'); }, TIMEOUT_MS);
  });
  console.log(`[done] reason=${reason} turn/completed observed=${completed}/${WATCH_N}`);
  return c.done(completed >= WATCH_N ? 0 : 1);
}

function writeTidFile(threadId) {
  if (!threadId) return;
  const tidFile = join(HERE, flags['tid-file'] || 'tid.txt');
  writeFileSync(tidFile, threadId + '\n');
  console.log(`[tid-file] wrote ${tidFile}`);
}

async function runStart() {
  // ThreadStartParams (schema/default/v2/ThreadStartParams.json): every property is optional,
  // "required": [] is absent entirely from the schema object. Built strictly from that schema:
  // only `cwd` (a plain nullable string, not AbsolutePathBuf) when --cwd is passed, else {}.
  const params = {};
  if (flags.cwd) params.cwd = String(flags.cwd);
  const c = await initClient();
  const r = await c.request('thread/start', params);
  console.log('[thread/start]', JSON.stringify(r.result ?? r.error, null, 2).slice(0, 1500));
  const threadId = r.result?.thread?.id ?? r.result?.threadId ?? null;
  if (threadId) console.log(`[threadId] ${threadId}`);
  // Write the threadId out as soon as the response arrives — before any watching begins —
  // so other steps/processes can read it immediately (T5 orchestration gate).
  writeTidFile(threadId);
  if (r.error) {
    console.error('[thread/start error]', JSON.stringify(r.error));
    return c.done(1);
  }
  // T5 correction: thread/start auto-subscribes the calling connection (see mode-comment
  // above for citation) — safe to watch turn/completed on this same connection now.
  return watchTurnCompleted(c);
}

async function runResume(threadId) {
  if (!threadId) { console.error('threadId required'); process.exit(2); }
  // ThreadResumeParams (schema/default/v2/ThreadResumeParams.json and
  // schema/experimental/v2/ThreadResumeParams.json): "required": ["threadId"]; "excludeTurns"
  // is present in both schemas' "properties" as an optional boolean — only sent when asked for.
  const params = { threadId };
  if (flags['exclude-turns']) params.excludeTurns = true;
  const c = await initClient();
  const r = await c.request('thread/resume', params);
  console.log('[thread/resume]', JSON.stringify(r.result ?? r.error).slice(0, 600));
  if (r.error) {
    console.error('[thread/resume error]', JSON.stringify(r.error));
    return c.done(1);
  }
  return watchTurnCompleted(c);
}

async function runTurn(threadId, text) {
  if (!threadId) { console.error('threadId required'); process.exit(2); }
  // TurnStartParams (schema/default/v2/TurnStartParams.json): "required": ["input","threadId"].
  const c = await initClient();
  const r = await c.request('turn/start', {
    threadId,
    input: [{ type: 'text', text: text ?? 'D6 spike: message delivered via turn/start.' }],
  });
  console.log('[turn/start]', JSON.stringify(r.result ?? r.error, null, 2).slice(0, 1500));
  if (r.error) {
    console.error('[turn/start error]', JSON.stringify(r.error));
    return c.done(1);
  }
  // Run-and-exit: this mode never watches for turn/completed itself (that is
  // conn1/conn2's job via start/resume's --watch-turn-completed).
  return c.done(0);
}

async function runQueue(threadId, text) {
  if (!threadId) { console.error('threadId required'); process.exit(2); }
  // ThreadQueueAddParams (schema/experimental/v2/ThreadQueueAddParams.json, experimental):
  // "required": ["clientUserMessageId","input","threadId"].
  const c = await initClient();
  const r = await c.request('thread/queue/add', {
    threadId,
    clientUserMessageId: randomUUID(),
    input: [{ type: 'text', text: text ?? 'D6 spike: message delivered via thread/queue/add.' }],
  });
  console.log('[thread/queue/add]', JSON.stringify(r.result ?? r.error, null, 2));
  if (r.error) {
    console.error('[thread/queue/add error]', JSON.stringify(r.error));
    return c.done(1);
  }
  // Run-and-exit, same shape as turn.
  return c.done(0);
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

const isMain = !!process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href;
if (isMain) {
  writeMetaLine();
  if (mode === 'start') runStart();
  else if (mode === 'resume') runResume(rest[0]);
  else if (mode === 'turn') runTurn(rest[0], rest[1]);
  else if (mode === 'queue') runQueue(rest[0], rest[1]);
  else {
    console.error('unknown mode; usage: start [--cwd DIR] [--watch-turn-completed N] [--timeout-ms MS] [--tid-file PATH] | resume <threadId> [--exclude-turns] [--watch-turn-completed N] [--timeout-ms MS] | turn <threadId> "<text>" | queue <threadId> "<text>"');
    process.exit(2);
  }
}

export { parseArgs };
